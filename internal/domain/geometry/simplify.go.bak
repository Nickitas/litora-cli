package geometry

import (
	"fmt"
	"math"

	"github.com/paulmach/orb"
	"github.com/paulmach/orb/simplify"
)

type pointXY struct {
	X float64
	Y float64
}

type SimplifyOptions struct {
	MaxPoints int
}

type SimplifyResult struct {
	Points           []LatLon
	OriginalCount    int
	SimplifiedCount  int
	ToleranceMeters  float64
	Applied          bool
	OriginalClosed   bool
	SimplifiedClosed bool
}

// SimplifyPolyline simplifies a polyline using Douglas-Peucker algorithm from orb/simplify.
// For closed polylines, it uses Visvalingam to avoid topology issues.
func SimplifyPolyline(points []LatLon, options SimplifyOptions) SimplifyResult {
	cloned := clonePoints(points)
	result := SimplifyResult{
		Points:          cloned,
		OriginalCount:   len(points),
		SimplifiedCount: len(points),
	}

	if len(points) < 3 || options.MaxPoints <= 0 || len(points) <= options.MaxPoints {
		result.OriginalClosed = isClosedPolyline(points)
		result.SimplifiedClosed = result.OriginalClosed
		return result
	}

	closed := isClosedPolyline(points)
	result.OriginalClosed = closed

	working := cloned
	target := options.MaxPoints
	minPoints := 2
	if closed {
		if len(working) <= 4 || target <= 4 {
			result.SimplifiedClosed = true
			return result
		}
		working = clonePoints(working[:len(working)-1])
		target--
		minPoints = 3
	}

	if target < minPoints {
		target = minPoints
	}
	if len(working) <= target {
		result.SimplifiedClosed = closed
		return result
	}

	// Convert to orb.LineString
	lineString := ToORBLineString(working)
	diagonal := projectedDiagonal(working)
	if diagonal <= 0 {
		result.SimplifiedClosed = closed
		return result
	}

	// For closed polylines (coastlines), use Visvalingam to preserve topology
	// Visvalingam better preserves the shape of polygons
	if closed {
		return simplifyVisvalingamToTarget(working, lineString, target, diagonal, result)
	}

	// For open polylines, use Douglas-Peucker
	return simplifyDouglasPeuckerToTarget(working, lineString, target, diagonal, result)
}

func simplifyDouglasPeuckerToTarget(working []LatLon, lineString orb.LineString, target int, diagonal float64, result SimplifyResult) SimplifyResult {
	closed := result.OriginalClosed
	minPoints := 2
	if closed {
		minPoints = 3
	}

	// Calculate reference latitude for meters-to-degrees conversion
	refLat := 0.0
	for _, p := range working {
		refLat += p.Lat
	}
	refLat /= float64(len(working))

	// Convert diagonal from meters to degrees for orb/simplify (which expects degrees)
	metersPerDegLat := 111194.9
	metersPerDegLon := metersPerDegLat * cosRad(refLat)
	avgMetersPerDeg := (metersPerDegLat + metersPerDegLon) / 2
	diagonalDeg := diagonal / avgMetersPerDeg

	// Binary search for tolerance that gives us the target point count
	low := 0.0
	high := diagonalDeg
	best := lineString
	bestTolerance := 0.0

	for i := 0; i < 32; i++ {
		mid := (low + high) / 2
		simplifiedGeom := simplify.DouglasPeucker(mid).Simplify(lineString)
		simplified, ok := simplifiedGeom.(orb.LineString)
		if !ok {
			continue
		}
		simplifiedCount := len(simplified)

		if simplifiedCount > target {
			low = mid
			continue
		}
		if simplifiedCount < minPoints {
			high = mid
			continue
		}

		best = simplified
		bestTolerance = mid
		high = mid
	}

	if len(best) == len(lineString) {
		result.SimplifiedClosed = closed
		return result
	}

	simplifiedPoints := FromORBLineString(best)
	simplifiedPoints = removeAllDuplicates(simplifiedPoints)

	if closed && len(simplifiedPoints) > 0 {
		simplifiedPoints = append(simplifiedPoints, simplifiedPoints[0])
	}

	result.Points = simplifiedPoints
	result.SimplifiedCount = len(simplifiedPoints)
	result.ToleranceMeters = bestTolerance * avgMetersPerDeg
	result.Applied = true
	result.SimplifiedClosed = closed
	return result
}

func simplifyVisvalingamToTarget(working []LatLon, lineString orb.LineString, target int, diagonal float64, result SimplifyResult) SimplifyResult {
	closed := result.OriginalClosed
	minPoints := 3

	// Visvalingam works by area threshold - we need to find the right threshold
	// Binary search for threshold that gives us the target point count
	low := 0.0
	high := diagonal * diagonal / 4.0 // Start with quarter of diagonal area
	best := lineString
	bestThreshold := 0.0

	for i := 0; i < 32; i++ {
		mid := (low + high) / 2
		simplifiedGeom := simplify.VisvalingamThreshold(mid).Simplify(lineString)
		simplified, ok := simplifiedGeom.(orb.LineString)
		if !ok {
			continue
		}
		simplifiedCount := len(simplified)

		if simplifiedCount > target {
			low = mid
			continue
		}
		if simplifiedCount < minPoints {
			high = mid
			continue
		}

		best = simplified
		bestThreshold = mid
		high = mid
	}

	if len(best) == len(lineString) {
		result.SimplifiedClosed = closed
		return result
	}

	simplifiedPoints := FromORBLineString(best)
	simplifiedPoints = removeAllDuplicates(simplifiedPoints)

	if closed && len(simplifiedPoints) > 0 {
		simplifiedPoints = append(simplifiedPoints, simplifiedPoints[0])
	}

	result.Points = simplifiedPoints
	result.SimplifiedCount = len(simplifiedPoints)
	result.ToleranceMeters = bestThreshold
	result.Applied = true
	result.SimplifiedClosed = closed
	return result
}
	simplifiedPoints = removeAllDuplicates(simplifiedPoints)

	if closed && len(simplifiedPoints) > 0 {
		// Add first point at end to close the polyline properly
		simplifiedPoints = append(simplifiedPoints, simplifiedPoints[0])
	}

	result.Points = simplifiedPoints
	result.SimplifiedCount = len(simplifiedPoints)
	result.ToleranceMeters = bestTolerance * avgMetersPerDeg  // Convert back to meters for reporting
	result.Applied = true
	result.SimplifiedClosed = closed
	return result
}

// SimplifyPolylineWithTolerance simplifies a polyline with a specific tolerance.
func SimplifyPolylineWithTolerance(points []LatLon, toleranceMeters float64) []LatLon {
	if len(points) < 3 || toleranceMeters <= 0 {
		return clonePoints(points)
	}

	lineString := ToORBLineString(points)
	simplifiedGeom := simplify.DouglasPeucker(toleranceMeters).Simplify(lineString)
	simplified, ok := simplifiedGeom.(orb.LineString)
	if !ok {
		return clonePoints(points)
	}

	result := FromORBLineString(simplified)
	return removeAllDuplicates(result)
}

// SimplifyVisvalingam simplifies a polyline using Visvalingam algorithm.
func SimplifyVisvalingam(points []LatLon, threshold float64, minPointsToKeep int) []LatLon {
	if len(points) < 3 {
		return clonePoints(points)
	}

	lineString := ToORBLineString(points)
	simplifiedGeom := simplify.VisvalingamThreshold(threshold).Simplify(lineString)
	simplified, ok := simplifiedGeom.(orb.LineString)
	if !ok {
		return clonePoints(points)
	}

	result := FromORBLineString(simplified)
	return removeAllDuplicates(result)
}

func isClosedPolyline(points []LatLon) bool {
	if len(points) < 2 {
		return false
	}
	return points[0] == points[len(points)-1]
}

func pointEquals(a, b LatLon) bool {
	const epsilon = 1e-10
	return a.Lat == b.Lat && a.Lon == b.Lon ||
		(a.Lat-b.Lat)*(a.Lat-b.Lat)+(a.Lon-b.Lon)*(a.Lon-b.Lon) < epsilon*epsilon
}

// removeConsecutiveDuplicates removes consecutive duplicate points from a polyline.
func removeConsecutiveDuplicates(points []LatLon) []LatLon {
	if len(points) < 2 {
		return points
	}

	result := make([]LatLon, 0, len(points))
	result = append(result, points[0])

	for i := 1; i < len(points); i++ {
		if !pointEquals(points[i], points[i-1]) {
			result = append(result, points[i])
		}
	}

	return result
}

// removeAllDuplicates removes ALL duplicate points from a polyline, not just consecutive ones.
// For closed polylines where Douglas-Peucker may introduce duplicates at corners,
// this cleans up the geometry while preserving the overall shape.
func removeAllDuplicates(points []LatLon) []LatLon {
	if len(points) < 2 {
		return points
	}

	result := make([]LatLon, 0, len(points))
	seen := make(map[string]bool)

	for _, p := range points {
		key := fmt.Sprintf("%.10f,%.10f", p.Lat, p.Lon)
		if !seen[key] {
			seen[key] = true
			result = append(result, p)
		}
	}

	return result
}

func clonePoints(points []LatLon) []LatLon {
	if len(points) == 0 {
		return nil
	}
	cloned := make([]LatLon, len(points))
	copy(cloned, points)
	return cloned
}

func projectedDiagonal(points []LatLon) float64 {
	if len(points) == 0 {
		return 0
	}

	// Use meters per degree at average latitude
	refLat := 0.0
	for _, point := range points {
		refLat += point.Lat
	}
	refLat /= float64(len(points))

	metersPerDegLat := 111194.9
	metersPerDegLon := metersPerDegLat * cosRad(refLat)
	if abs(metersPerDegLon) < 1e-9 {
		metersPerDegLon = metersPerDegLat
	}

	minX, maxX := points[0].Lon, points[0].Lon
	minY, maxY := points[0].Lat, points[0].Lat
	for _, point := range points[1:] {
		if point.Lon < minX {
			minX = point.Lon
		}
		if point.Lon > maxX {
			maxX = point.Lon
		}
		if point.Lat < minY {
			minY = point.Lat
		}
		if point.Lat > maxY {
			maxY = point.Lat
		}
	}

	dx := (maxX - minX) * metersPerDegLon
	dy := (maxY - minY) * metersPerDegLat
	return hypot(dx, dy)
}

func cosRad(deg float64) float64 {
	return math.Cos(deg * math.Pi / 180)
}

func abs(x float64) float64 {
	if x < 0 {
		return -x
	}
	return x
}

func hypot(x, y float64) float64 {
	return math.Hypot(x, y)
}
